rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    // Public, non-sensitive app configuration may be read by the client.
    // All writes must go through the authenticated backend/admin API.
    match /system/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // No client access to payment requests, wallet ledger, bets, referrals,
    // device fingerprints, or admin broadcasts. Server uses PostgreSQL.
    match /deposit_requests/{id} { allow read, write: if false; }
    match /withdrawal_requests/{id} { allow read, write: if false; }
    match /broadcast_notifications/{id} { allow read, write: if false; }
    match /device_registrations/{id} { allow read, write: if false; }
    match /referrals/{id} { allow read, write: if false; }

    match /users/{uid} {
      // Profile read only for owner. Client cannot change balance/role/status.
      allow read: if owner(uid);
      allow create, update, delete: if false;

      match /transactions/{id} { allow read, write: if false; }
      match /bets/{id} { allow read, write: if false; }
    }

    match /test/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}